// Copy this file to secrets.h and fill in your own WiFi credentials.
#ifndef SECRETS_H
#define SECRETS_H

#define WIFI_SSID     "your-wifi-name"
#define WIFI_PASSWORD "your-wifi-password"

// secrets.h is git-ignored. Never commit your real credentials.
